generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin_kiz
  pengetua
  fellow
  ahli
  staf
  /// Cafe operator — manages the KIZ Cafe (settings + menu) and views its
  /// orders, nothing else. Created by an admin, never self-registered.
  kafe
}

/// Self-service registration state machine. `unverified` = email link not yet
/// clicked; `pending` = email verified but the student's matric ID is not yet on
/// an active intake (locked until the admin uploads/verifies); `active` = usable.
enum AccountStatus {
  unverified
  pending
  active
}

model User {
  id              String        @id @default(uuid())
  matricId        String        @unique @map("matric_id")
  name            String
  email           String?       @unique
  emailVerifiedAt DateTime?     @map("email_verified_at")
  accountStatus   AccountStatus @default(active) @map("account_status")
  passwordHash    String        @map("password_hash")
  role            Role          @default(ahli)
  block           String?
  roomNumber      String?       @map("room_number")
  residentCardQr  String        @map("resident_card_qr")
  phone           String?
  /// Office held within a role. Only meaningful for `pengetua`: null / "pengetua"
  /// = Principal, "timbalan_pengetua" = Deputy Principal. Same permissions either
  /// way — this only changes the label shown on the Digital Resident ID.
  position        String?
  avatarUrl       String?       @map("avatar_url")
  ecardRegisteredAt DateTime?   @map("ecard_registered_at")
  lastSeenAt      DateTime?     @map("last_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  facilityBookings   FacilityBooking[]    @relation("UserFacilityBookings")
  approvedBookings   FacilityBooking[]    @relation("ApprovedBookings")
  guestHouseBookings GuestHouseBooking[]
  approvedGhBookings GuestHouseBooking[]  @relation("ApprovedGHBookings")
  helpdeskTickets    HelpdeskTicket[]      @relation("UserTickets")
  assignedTickets    HelpdeskTicket[]      @relation("AssignedTickets")
  helpdeskMessages   HelpdeskMessage[]    @relation("UserMessages")
  announcements      Announcement[]
  chatMessages       CommunityChatMessage[]
  deletedChatMessages CommunityChatMessage[] @relation("DeletedMessages")
  chatReactions      ChatMessageReaction[]
  chatReports        ChatMessageReport[]   @relation("ChatReporters")
  parcels            Parcel[]
  lostFoundItems     LostFoundItem[]
  importedIntakes    Intake[]
  eligibleRecords    EligibleStudent[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")
  announcementAcknowledgements AnnouncementAcknowledgment[]
  announcementReactions AnnouncementReaction[]
  announcementReads AnnouncementRead[]
  createdCheckInSessions CheckInSession[]   @relation("CreatedCheckInSessions")
  manualCheckInRecords   CheckInRecord[]    @relation("ManualCheckInRecords")
  uploadedGuides         Guide[]            @relation("UploadedGuides")
  guideReads             GuideRead[]
  mobileSessions         MobileSession[]
  deviceTokens           DeviceToken[]
  laundryReminders       LaundryReminder[]
  sentNotifications      Notification[]          @relation("SentNotifications")
  receivedNotifications  NotificationRecipient[] @relation("ReceivedNotifications")
  cafeOrders             CafeOrder[]

  @@map("users")
}

/// A signed-in mobile app session. The mobile client holds an opaque bearer
/// token; the DB only ever stores its SHA-256 hash (same pattern as the email
/// verification / invitation tokens). Sliding expiry: every authenticated
/// request bumps `lastUsedAt` and pushes `expiresAt` forward. Soft-deleted on
/// sign-out so a stolen token can be revoked server-side.
model MobileSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  platform   String    @default("unknown")
  deviceName String?   @map("device_name")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mobile_sessions")
}

/// Expo push token registered by a device. One user may have several (phone +
/// tablet). Upserted on each app launch; soft-deleted on sign-out or when Expo
/// reports the token is no longer valid.
model DeviceToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  platform   String    @default("unknown")
  deviceName String?   @map("device_name")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

/// Direction of a check-in counter session and its records. A `check_in`
/// session opens move-in; a `check_out` session opens move-out at semester end.
enum CheckInType {
  check_in
  check_out
}

/// A single QR code campaign for the check-in / check-out counter. The admin
/// creates one per session (long/short sem), toggles it active/inactive, prints
/// the QR, and pastes it at the counter. Students scan it from their own phone.
model CheckInSession {
  id          String       @id @default(uuid())
  name        String
  type        CheckInType
  /// Random token embedded in the QR URL (`/checkin/<token>`). Public-facing.
  token       String       @unique
  /// Optional validity window (Malaysia time). Scans outside it are rejected.
  opensAt     DateTime?    @map("opens_at")
  closesAt    DateTime?    @map("closes_at")
  isActive    Boolean      @default(true) @map("is_active")
  createdById String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  createdBy User             @relation("CreatedCheckInSessions", fields: [createdById], references: [id])
  records   CheckInRecord[]

  @@map("check_in_sessions")
}

/// One student's signed check-in / check-out at the counter. Matric/name/room
/// are snapshotted so the admin record ("fail pentadbiran") stays stable even
/// if the allocation later changes. Signature PNG + KL timestamp only.
model CheckInRecord {
  id                String      @id @default(uuid())
  sessionId         String      @map("session_id")
  eligibleStudentId String?     @map("eligible_student_id")
  matricId          String      @map("matric_id")
  name              String
  type              CheckInType
  roomLabel         String?     @map("room_label")
  signatureUrl      String?     @map("signature_url")
  /// Set when an admin recorded this on the student's behalf (no signature).
  manualById        String?     @map("manual_by")
  signedAt          DateTime    @map("signed_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  session  CheckInSession  @relation(fields: [sessionId], references: [id])
  student  EligibleStudent? @relation(fields: [eligibleStudentId], references: [id])
  manualBy User?           @relation("ManualCheckInRecords", fields: [manualById], references: [id])

  @@index([sessionId])
  @@index([eligibleStudentId])
  @@index([manualById])
  @@map("check_in_records")
}

/// Single-use email-verification tokens. The raw token is never stored — only a
/// SHA-256 hash, so a DB leak cannot be replayed. Consumed tokens are soft-deleted.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("verification_tokens")
}

/// A single-use, time-boxed password-reset token, emailed when a member uses
/// "Forgot password?". Same security model as `VerificationToken`: only the
/// SHA-256 hash is stored, the raw token never touches the DB, it expires and
/// is soft-deleted on use. Clicking the link also proves control of the email,
/// so the reset flow doubles as an email verification.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A superadmin-issued invitation for someone to self-register with a chosen
/// role (student or admin). The raw invite token is emailed; only its SHA-256
/// hash is stored. A student invitation whose matric matches the active intake
/// is flagged `resident`, so registering + verifying activates and links the
/// account straight away. Admin invitations never need an intake match.
model Invitation {
  id          String    @id @default(uuid())
  email       String
  role        Role      @default(ahli)
  matricId    String?   @map("matric_id")
  name        String?
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  /// True when the matric matched the active intake at send time (students only).
  resident    Boolean   @default(false)
  /// Set when the invitee completes registration.
  acceptedAt   DateTime? @map("accepted_at")
  acceptedById String?   @map("accepted_by")
  /// Set when a superadmin revokes the invitation.
  revokedAt   DateTime? @map("revoked_at")
  lastSentAt  DateTime? @map("last_sent_at")
  sentCount   Int       @default(1) @map("sent_count")
  invitedById String?   @map("invited_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  invitedBy  User? @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedBy User? @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([email])
  @@index([invitedById])
  @@map("invitations")
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled
}

model Block {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  navigationNotes String?  @map("navigation_notes")
  panoramaImage   String?  @map("panorama_image")
  panoramaLeftX   Int      @default(20) @map("panorama_left_x")
  panoramaRightX  Int      @default(80) @map("panorama_right_x")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  facilities Facility[]

  @@map("blocks")
}

model Office {
  id            String   @id @default(uuid())
  name          String   @unique
  /// English display title shown on the student office cards. Falls back to `name`.
  nameEn        String?  @map("name_en")
  description   String?
  /// Category chip shown above the card title (e.g. "Student & College Matters").
  categoryLabel String?  @map("category_label")
  categoryIcon  String?  @map("category_icon")
  categoryTone  String?  @map("category_tone")
  /// "Go here for" bullet list of services handled by this office.
  services      String[] @default([])
  /// Where the office is, e.g. "Ground Floor · KIZ Lobby".
  location      String?  @map("location")
  /// Human hours label, e.g. "Monday–Friday · 8:00 AM–5:00 PM".
  hoursLabel    String?  @map("hours_label")
  phone         String?  @map("phone")
  featuredImage String?  @map("featured_image")
  gallery       String[] @map("gallery")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("offices")
}

/// Upcoming KIZ activity/programme — powers the "Upcoming at KIZ" dashboard widget.
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  venue       String?
  startsAt    DateTime @map("starts_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([startsAt])
  @@map("events")
}

/// Kind of a managed dashboard content item. `emergency_contact` rows feed the
/// "Emergency Contact" widget; `living_guide` rows feed "Life at KIZ".
enum ContentKind {
  emergency_contact
  living_guide
}

/// Managed dashboard content — emergency contacts and the digital living guide.
/// Kept deliberately generic (label + optional phone/link/description) so admins
/// can publish small info widgets without a schema change.
model ContentItem {
  id        String      @id @default(uuid())
  kind      ContentKind
  title     String
  subtitle  String?
  body      String?
  phone     String?
  link      String?
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  @@index([kind])
  @@map("content_items")
}

/// Outbound social / contact link shown in the member dashboard "Stay Connected"
/// section. Admin-managed so the section can be relabelled, reordered, toggled
/// and extended with more links without a schema change. `icon` is a key from
/// `lib/social-meta.ts` (rendered by `components/shared/social-icon.tsx`).
model SocialLink {
  id          String    @id @default(uuid())
  label       String
  description String?
  url         String
  icon        String    @default("link")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([sortOrder])
  @@map("social_links")
}

/// Kind of place the AR Directory can navigate to.
enum DestinationType {
  block
  facility
  office
  room
  hall
  seminar
  meeting
  admin
}

/// AR Directory destination — an admin-managed lat/lng pin the student page
/// points the camera-arrow at. GPS for all of them (indoor places included:
/// the admin building is a single elongated floor, so a per-room pin is enough).
model Destination {
  id          String          @id @default(uuid())
  name        String
  type        DestinationType
  icon        String          @default("place")
  latitude    Float
  longitude   Float
  indoor      Boolean         @default(false) @map("indoor")
  building    String?
  description String?
  /// Has this pin's lat/lng been confirmed on a real device or against
  /// Google Maps? Defaults to false so estimated/seeded pins are visibly
  /// flagged for the admin to double-check before students rely on them.
  verified    Boolean         @default(false) @map("verified")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  @@map("destinations")
}

/// Whether a facility can be booked ahead of time. Bookable facilities appear
/// under the "Bookable Facilities" directory section (reservation required);
/// shared facilities are available without advance booking.
enum FacilitySection {
  bookable
  shared
}

/// Live availability of a facility shown to residents.
enum FacilityStatus {
  open
  coming_soon
}

/// A resident-facing grouping for facilities within one directory section
/// (e.g. "Event & Meeting Spaces" under bookable, "Resident Services" under
/// shared). Admin-managed; drives the sub-headings on the member directory.
model FacilityCategory {
  id        String           @id @default(uuid())
  name      String
  section   FacilitySection
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  facilities Facility[]

  @@unique([section, name])
  @@map("facility_categories")
}

model Facility {
  id               String          @id @default(uuid())
  name             String          @unique
  blockId          String          @map("block_id")
  description      String
  featuredImage    String?         @map("featured_image")
  gallery          String[]        @map("gallery")
  price            Float?
  capacity         Int?
  timeSlotDuration Int?            @map("time_slot_duration")
  maxPerDay        Int?            @default(3) @map("max_per_day")
  requiresApproval Boolean         @default(true) @map("requires_approval")
  // ── Facilities directory ──────────────────────────────────────────────────
  // `bookable` drives the top-level directory section ("Bookable Facilities"
  // vs "Shared Facilities"); it stays in sync with the category's section.
  // `status` shows whether the facility is open now or coming soon.
  categoryId String?         @map("category_id")
  bookable   Boolean         @default(true)
  status     FacilityStatus  @default(open)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  block    Block                       @relation(fields: [blockId], references: [id])
  category FacilityCategory?           @relation(fields: [categoryId], references: [id])
  bookings FacilityBooking[]

  @@map("facilities")
}

model FacilityBooking {
  id            String        @id @default(uuid())
  facilityId    String        @map("facility_id")
  userId        String        @map("user_id")
  timeSlotStart DateTime      @map("time_slot_start")
  timeSlotEnd   DateTime      @map("time_slot_end")
  purpose       String?
  status        BookingStatus @default(pending)
  approvedById  String?       @map("approved_by")
  bookingRef    String?       @unique @map("booking_ref")
  pdfUrl        String?       @map("pdf_url")
  adminNotes    String?       @map("admin_notes")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  facility   Facility @relation(fields: [facilityId], references: [id])
  user       User     @relation("UserFacilityBookings", fields: [userId], references: [id])
  approvedBy User?    @relation("ApprovedBookings", fields: [approvedById], references: [id])

  @@map("facility_bookings")
}

enum GuestHouseBookingStatus {
  pending
  approved
  rejected
  checked_in
  checked_out
  cancelled
}

enum PeriodType {
  daily
  weekly
  monthly
}

enum PaymentStatus {
  unpaid
  paid_manual
}

model GuestHouse {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String
  featuredImage    String?  @map("featured_image")
  gallery          String[] @map("gallery")
  price            Float?
  capacity         Int?
  maxDays          Int?     @map("max_days")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  bookings GuestHouseBooking[]

  @@map("guest_houses")
}

model GuestHouseBooking {
  id            String                    @id @default(uuid())
  guestHouseId  String                    @map("guest_house_id")
  userId        String                    @map("user_id")
  guestName     String                    @map("guest_name")
  periodType    PeriodType                @map("period_type")
  startDate     DateTime                  @map("start_date") @db.Date
  endDate       DateTime                  @map("end_date") @db.Date
  status        GuestHouseBookingStatus   @default(pending)
  approvedById  String?                   @map("approved_by")
  paymentStatus PaymentStatus             @default(unpaid) @map("payment_status")
  notes         String?
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  deletedAt     DateTime?                 @map("deleted_at")

  guestHouse GuestHouse @relation(fields: [guestHouseId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  approvedBy User?      @relation("ApprovedGHBookings", fields: [approvedById], references: [id])

  @@index([guestHouseId])
  @@map("guest_house_bookings")
}

/// What a helpdesk ticket is about — routes the request to the right team and
/// labels the ticket everywhere it appears. Order here drives the picker order.
enum HelpdeskCategory {
  accommodation_room
  room_change
  maintenance_repair
  facilities_booking
  cleanliness_waste
  internet_technology
  safety_security
  payment_charges
  student_welfare
  general_enquiry
}

/// Distinguishes a quick live Q&A with the office (`live`) from a structured,
/// tracked request/application (`ticket`). Same chat thread + admin inbox; the
/// channel only changes the friction (no category form) and the lifecycle.
enum HelpdeskChannel {
  live
  ticket
}

/// Full ticket lifecycle. Declared in workflow order so `orderBy status` sorts
/// fresh work first in the admin inbox.
enum HelpdeskStatus {
  submitted
  under_review
  in_progress
  more_info_required
  resolved
  closed
}

model HelpdeskTicket {
  id             String          @id @default(uuid())
  displayId      Int             @unique @default(autoincrement()) @map("display_id")
  userId         String          @map("user_id")
  subject        String?
  category       HelpdeskCategory @default(general_enquiry)
  /// Live Q&A vs structured request — see HelpdeskChannel.
  channel        HelpdeskChannel @default(ticket)
  /// Where the ticket came from: "web" (default) or "concierge" (KIZ-AI handoff).
  origin         String?         @map("origin")
  status         HelpdeskStatus  @default(submitted)
  /// Building the issue is about (e.g. "K18A"). Free text so it works before
  /// the block inventory is configured.
  locationBlock  String?         @map("location_block")
  /// Room number OR facility name the issue is about.
  locationDetail String?         @map("location_detail")
  assignedTo     String?         @map("assigned_to")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  user     User              @relation("UserTickets", fields: [userId], references: [id])
  assignee User?             @relation("AssignedTickets", fields: [assignedTo], references: [id])
  messages HelpdeskMessage[]

  @@map("helpdesk_tickets")
}

model HelpdeskMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  senderId    String   @map("sender_id")
  /// The message exactly as the sender typed it. For live-chat messages this is
  /// the original language; `translationEn`/`translationZh` hold the auto
  /// translations so every reader can view it in their own language.
  message     String
  isAutoReply Boolean  @default(false) @map("is_auto_reply")
  /// Detected language of `message` ("zh", "en", "ms") — live chat only.
  sourceLang    String?  @map("source_lang")
  /// English translation of `message` — live chat only.
  translationEn String?  @map("translation_en")
  /// Simplified Mandarin translation of `message` — live chat only.
  translationZh String?  @map("translation_zh")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id])
  sender User           @relation("UserMessages", fields: [senderId], references: [id])

  @@map("helpdesk_messages")
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  content        String
  tag            String    @default("umum")
  attachmentUrl  String?   @map("attachment_url")
  attachmentType String?   @map("attachment_type")
  isPinned       Boolean   @default(false) @map("is_pinned")
  scheduledAt    DateTime? @map("scheduled_at")
  expiresAt      DateTime? @map("expires_at")
  postedBy       String    @map("posted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  poster User @relation(fields: [postedBy], references: [id])

  acknowledgements AnnouncementAcknowledgment[]
  reactions AnnouncementReaction[]
  reads AnnouncementRead[]

  @@map("announcements")
}

/// A user's explicit acknowledgement of a specific announcement (used by the
/// dashboard "Acknowledge important announcement" task).
model AnnouncementAcknowledgment {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  announcementId String    @map("announcement_id")
  acknowledgedAt DateTime  @default(now()) @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@unique([userId, announcementId])
  @@index([announcementId])
  @@map("announcement_acknowledgements")
}

/// A resident's reaction to an announcement: Noted / Excited / Interested.
/// Toggled on/off (soft delete, never hard delete). For "important"
/// announcements the "noted" reaction doubles as the acknowledgement that
/// clears the dashboard "Things to Do" task.
model AnnouncementReaction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  announcementId String   @map("announcement_id")
  /// "noted" | "excited" | "interested" (plain string, mirrors `tag`).
  type           String   @default("noted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@unique([userId, announcementId, type])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reactions")
}

/// Whether a member has opened an announcement. Unread cards keep a green
/// "New/Unread" dot that clears once the announcement is opened.
model AnnouncementRead {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  announcementId String   @map("announcement_id")
  readAt         DateTime @default(now()) @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@unique([userId, announcementId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

model CommunityChatMessage {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  message   String
  /// Message this one is replying to (inline quote thread), if any.
  replyToId String?   @map("reply_to_id")
  /// Optional attachment — URL under /uploads, kind ("image"|"pdf"), display name.
  attachmentUrl  String? @map("attachment_url")
  attachmentType String? @map("attachment_type")
  attachmentName String? @map("attachment_name")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user           User                  @relation(fields: [userId], references: [id])
  replyTo        CommunityChatMessage? @relation("ChatReplies", fields: [replyToId], references: [id])
  replies        CommunityChatMessage[] @relation("ChatReplies")
  deletedByUser  User?                 @relation("DeletedMessages", fields: [deletedBy], references: [id])
  reactions      ChatMessageReaction[]
  reports        ChatMessageReport[]

  @@index([replyToId])
  @@map("community_chat_messages")
}

/// A resident's emoji reaction to a community chat message. One row per
/// (user, message, emoji); toggled on/off via soft delete.
model ChatMessageReaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  messageId String   @map("message_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user    User                  @relation(fields: [userId], references: [id])
  message CommunityChatMessage @relation(fields: [messageId], references: [id])

  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@map("chat_message_reactions")
}

/// A member reporting a community chat message. Admins review open reports
/// inline (delete the message / dismiss the report). Soft-deleted when handled.
model ChatMessageReport {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  reporterId String   @map("reporter_id")
  /// Preset reason ("spam" | "harassment" | "inappropriate" | "other").
  reason     String
  /// Optional free-text detail from the reporter.
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  message  CommunityChatMessage @relation(fields: [messageId], references: [id])
  reporter User                 @relation("ChatReporters", fields: [reporterId], references: [id])

  @@index([messageId])
  @@index([reporterId])
  @@map("chat_message_reports")
}

model Parcel {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  description String?
  status      String    @default("arrived")
  notifiedAt  DateTime? @map("notified_at")
  collectedAt DateTime? @map("collected_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("parcels")
}

enum LostFoundStatus {
  lost
  found
  claimed
}

enum Gender {
  male
  female
}

enum RoomType {
  single
  double
}

enum RoomStatus {
  available
  maintenance
  closed
}

enum BedPosition {
  single
  left
  right
}

enum IntakeStatus {
  draft
  imported
  active
  archived
}

enum RoomApplicationType {
  single
  double
  flexible
}

enum RoomApplicationStatus {
  single_pending
  roommate_pending
  roommate_confirmed
  flexible_submitted
  roommate_rejected
  allocated
  withdrawn
}

model ResidenceBlock {
  id          String   @id @default(uuid())
  name        String   @unique
  gender      Gender
  floors      Int      @default(4)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rooms ResidenceRoom[]

  @@map("residence_blocks")
}

model ResidenceRoom {
  id        String     @id @default(uuid())
  blockId   String     @map("block_id")
  floor     Int
  number    String
  type      RoomType   @default(double)
  status    RoomStatus @default(available)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  block ResidenceBlock @relation(fields: [blockId], references: [id])
  beds  Bed[]

  @@unique([blockId, number])
  @@map("residence_rooms")
}

model Bed {
  id         String      @id @default(uuid())
  roomId     String      @map("room_id")
  position   BedPosition
  occupantId String?     @unique @map("occupant_id")
  /// Held back from student allocation (emergency / pengetua quota / staff).
  reserved   Boolean     @default(false)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  room     ResidenceRoom    @relation(fields: [roomId], references: [id])
  occupant EligibleStudent? @relation(fields: [occupantId], references: [id])

  @@unique([roomId, position])
  @@map("beds")
}

model SelectionWindow {
  id               String    @id @default(uuid())
  name             String
  opensAt          DateTime  @map("opens_at")
  closesAt         DateTime  @map("closes_at")
  isActive         Boolean   @default(true) @map("is_active")
  closingSoonHours Int       @default(24) @map("closing_soon_hours")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("selection_windows")
}

model Intake {
  id           String       @id @default(uuid())
  name         String
  status       IntakeStatus @default(imported)
  importedById String?      @map("imported_by")
  rowCount     Int          @default(0) @map("row_count")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  importedBy User?             @relation(fields: [importedById], references: [id])
  students   EligibleStudent[]

  @@map("intakes")
}

model EligibleStudent {
  id                String    @id @default(uuid())
  intakeId          String    @map("intake_id")
  matricId          String    @map("matric_id")
  name              String
  gender            Gender
  faculty           String?
  yearOfStudy       String?   @map("year_of_study")
  religion          String?
  race              String?
  nationality       String    @default("Malaysia")
  currentCollege    String?   @map("current_college")
  choice1           String?
  applicationDate   DateTime? @map("application_date")
  applicationStatus String?   @map("application_status")
  // ── UKM Real Estate registration + tenancy (read-only in KIZ) ─────────────
  // "Mendaftar" means the student has been to the UKM RE counter, registered
  // and paid the deposit. Payment + contract dates are owned by UKM RE and flow
  // in from the sheet; KIZ only decides the room, never edits these.
  isRegistered      Boolean   @default(false) @map("is_registered")
  contractStart     DateTime? @map("contract_start")
  contractEnd       DateTime? @map("contract_end")
  isB40             Boolean   @default(false) @map("is_b40")
  isOku             Boolean   @default(false) @map("is_oku")
  isUniform         Boolean   @default(false) @map("is_uniform")
  merit             Float?
  userId            String?   @map("user_id")
  selectedAt        DateTime? @map("selected_at")
  assignedByAdmin   Boolean   @default(false) @map("assigned_by_admin")
  // ── Resident onboarding ───────────────────────────────────────────────────
  // Final check-in/out happens at the counter via the QR-session flow and is
  // recorded in CheckInRecord (signedAt). No accommodation-payment column: fees
  // are settled manually at the UKM Real Estate counter (no payment gateway).
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  intake Intake @relation(fields: [intakeId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  bed    Bed?
  roomApplication      RoomApplication?  @relation("RoomApplicationApplicant")
  roommateApplications RoomApplication[] @relation("RoomApplicationRoommate")
  checkInRecords       CheckInRecord[]

  @@unique([intakeId, matricId])
  @@map("eligible_students")
}

// A student's accommodation request. This records preference only; `Bed` remains
// the source of truth for the final room allocated by the KIZ office.
model RoomApplication {
  id          String                @id @default(uuid())
  applicantId String                @unique @map("applicant_id")
  roommateId  String?               @map("roommate_id")
  type        RoomApplicationType
  status      RoomApplicationStatus
  submittedAt DateTime              @default(now()) @map("submitted_at")
  respondedAt DateTime?             @map("responded_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")

  applicant EligibleStudent  @relation("RoomApplicationApplicant", fields: [applicantId], references: [id])
  roommate  EligibleStudent? @relation("RoomApplicationRoommate", fields: [roommateId], references: [id])

  @@index([roommateId, status])
  @@map("room_applications")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ── Digital Guide ───────────────────────────────────────────────────────────
// Admin-uploaded PDFs (orientation guide, rules, programme guide) that every
// resident can read in-app as a flipbook or download. Read state is tracked per
// user so the library can flag "New" documents.

/// Fixed sections of the Digital Guide library.
enum GuideCategory {
  orientation
  rules
  program
  other
}

model Guide {
  id           String        @id @default(uuid())
  title        String
  description  String?
  category     GuideCategory @default(orientation)
  /// Path to the uploaded PDF under public/uploads/guides/.
  fileUrl      String        @map("file_url")
  /// Size of the stored PDF in bytes (for display).
  fileSize     Int?          @map("file_size")
  /// Optional cover image shown on the library card.
  coverImage   String?       @map("cover_image")
  /// Page count read from the PDF (for display; optional).
  pageCount    Int?          @map("page_count")
  published    Boolean       @default(true)
  isPinned     Boolean       @default(false) @map("is_pinned")
  sortOrder    Int           @default(0) @map("sort_order")
  uploadedById String?       @map("uploaded_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  uploadedBy User?       @relation("UploadedGuides", fields: [uploadedById], references: [id])
  reads      GuideRead[]

  @@index([category])
  @@map("guides")
}

/// Per-user "opened this guide" marker — drives the New badge in the library.
model GuideRead {
  id        String   @id @default(uuid())
  guideId   String   @map("guide_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guideId, userId])
  @@index([userId])
  @@map("guide_reads")
}

model LostFoundItem {
  id           String          @id @default(uuid())
  reportedBy   String          @map("reported_by")
  itemName     String          @map("item_name")
  description  String
  photoUrl     String?         @map("photo_url")
  status       LostFoundStatus @default(lost)
  locationFound String?        @map("location_found")
  /// Date (KL calendar) the item was lost or found.
  happenedDate DateTime?       @map("happened_date")
  /// Approximate time the item was lost/found ("HH:MM", 24h) — optional.
  happenedTime String?         @map("happened_time")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  reporter User @relation(fields: [reportedBy], references: [id])

  @@map("lost_found_items")
}

// ── KIZ-AI (retrieval-augmented concierge) ──────────────────────────────────
// A flat knowledge index over the app's own content (announcements, facilities,
// offices, events, guest houses, contacts). Embeddings are stored as a JSON
// number[] string — no pgvector needed; cosine similarity is computed in TS.

model AiKnowledge {
  id         String   @id @default(uuid())
  /// announcement | facility | office | content | guesthouse | event | faq
  sourceType String   @map("source_type")
  /// Id of the source row (null for static FAQ entries).
  sourceId   String?  @map("source_id")
  title      String
  content    String
  /// JSON-encoded embedding vector.
  embedding  String
  /// sha256 of title+content — lets re-index skip unchanged rows.
  hash       String
  /// Deep link a citation chip points at, e.g. "/ahli/pengumuman".
  href       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([sourceType])
  @@map("ai_knowledge")
}

/// Every question KIZ-AI couldn't answer confidently. Drives the admin
/// "top unanswered" list — write a FAQ/announcement, re-index, and the next
/// resident gets an instant answer (the feedback loop that reduces counter visits).
model AiUnansweredLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  question     String
  /// Best cosine score seen for this question (null when AI was off).
  bestScore    Float?   @map("best_score")
  /// Set once the resident escalates this question to the office.
  ticketId     String?  @map("ticket_id")
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([createdAt])
  @@map("ai_unanswered_log")
}

/// Admin-curated FAQ. The primary "training" surface for KIZ-AI: staff write a
/// question + answer, the row is indexed into `ai_knowledge`, and the concierge
/// answers it. Importable/exportable as CSV so staff can fill it in bulk.
model Faq {
  id        String   @id @default(uuid())
  category  String
  question  String
  answer    String   @default("")
  /// Comma-separated alternate phrasings / Malay & Mandarin terms to improve matching.
  keywords  String?
  language  String   @default("en")
  published Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([category])
  @@map("faqs")
}

// ── Laundry (reminder-based machine status) ─────────────────────────────────
// No machine API exists, so a machine's live status is derived from the
// reminders residents set: no_active / active / timer_ended / out_of_service.
// `out_of_service` is the only admin-set state; everything else is computed
// from the latest reminder's `endsAt` (see `lib/laundry.ts`). No cron needed.

enum LaundryMachineStatus {
  available
  out_of_service
}

/// Why a reminder stopped before/after its natural end.
enum LaundryReminderEndReason {
  cancelled
  /// A newer reminder on the same machine replaced it.
  superseded
  /// An admin force-cleared the machine.
  cleared
}

model LaundryMachine {
  id        String               @id @default(uuid())
  name      String
  /// Free-text location label, e.g. "Laundry Room, Block K18A".
  location  String?
  imageUrl  String?              @map("image_url")
  status    LaundryMachineStatus @default(available)
  sortOrder Int                  @default(0) @map("sort_order")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  deletedAt DateTime?            @map("deleted_at")

  reminders LaundryReminder[]

  @@map("laundry_machines")
}

model LaundryReminder {
  id              String                    @id @default(uuid())
  machineId       String                    @map("machine_id")
  userId          String                    @map("user_id")
  durationMinutes Int                       @map("duration_minutes")
  /// KL wall-clock start (Asia/Kuala_Lumpur via `nowMalaysia()`).
  startedAt       DateTime                  @map("started_at")
  endsAt          DateTime                  @map("ends_at")
  /// Set when cancelled / superseded / cleared — null while running.
  endedAt         DateTime?                 @map("ended_at")
  endedReason     LaundryReminderEndReason? @map("ended_reason")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  deletedAt       DateTime?                 @map("deleted_at")

  machine LaundryMachine @relation(fields: [machineId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  @@index([machineId])
  @@index([userId])
  @@map("laundry_reminders")
}

// ── Push notifications (broadcast) ──────────────────────────────────────────
// Admin-composed messages fanned out to residents over three channels: an
// in-app inbox row, an Expo push notification (which the Expo Push Service
// delivers through APNs / FCM), and email (Resend). One `Notification` is the
// campaign; one `NotificationRecipient` per targeted user carries that user's
// read + delivery state.

/// Who a broadcast targets. `all` = every active user, `role` = everyone in
/// `audienceRole`, `selected` = the users whose recipient rows exist.
enum NotificationAudience {
  all
  role
  selected
}

model Notification {
  id             String               @id @default(uuid())
  title          String
  body           String
  /// Optional in-app deep link opened when the notification is tapped,
  /// e.g. "/ahli/tempahan". Also passed to the push payload as `data.link`.
  link           String?
  audience       NotificationAudience @default(all)
  /// Set only when `audience` is `role`.
  audienceRole   Role?                @map("audience_role")
  /// Enabled channels — any of "in_app" | "push" | "email".
  channels       String[]             @default([])
  sentById       String               @map("sent_by")
  recipientCount Int                  @default(0) @map("recipient_count")
  pushSentCount  Int                  @default(0) @map("push_sent_count")
  emailSentCount Int                  @default(0) @map("email_sent_count")
  failedCount    Int                  @default(0) @map("failed_count")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  sentBy     User                   @relation("SentNotifications", fields: [sentById], references: [id])
  recipients NotificationRecipient[]

  @@index([createdAt])
  @@map("notifications")
}

/// Per-user delivery + read state for one broadcast.
model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  /// When the recipient opened the notification in-app (null = unread).
  readAt         DateTime? @map("read_at")
  pushedAt       DateTime? @map("pushed_at")
  emailedAt      DateTime? @map("emailed_at")
  pushError      String?   @map("push_error")
  emailError     String?   @map("email_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

// ── Smart Ordering (KIZ Cafe) ───────────────────────────────────────────────
// The cafe uploads a photo of its menu; KIZ-AI's vision model reads it into
// `CafeItem` rows (draft until an admin reviews + publishes). Students build a
// cart and hand the order off to WhatsApp — the cafe receives a normal WhatsApp
// message, so there is no cafe-side app and no payment gateway (settled at
// pickup). See `lib/cafe.ts` + `lib/cafe-ai.ts`.

/// One orderable item on the cafe menu. AI-extracted rows start `published =
/// false` so they can't reach students until an admin confirms them.
model CafeItem {
  id          String   @id @default(uuid())
  name        String
  price       Float
  /// Grouping shown as a chip on the member menu, e.g. "Makanan" / "Minuman".
  category    String   @default("Makanan")
  description String?
  /// Dietary tags — keys from `lib/cafe-meta.ts` (halal / vegetarian / spicy / …).
  dietary     String[] @default([])
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([published])
  @@map("cafe_items")
}

/// A student's cafe order. Payment is settled face-to-face (no gateway). The
/// line items are snapshotted as JSON so "My Orders" and one-tap reorder keep
/// working even after the menu changes. `whatsappSentAt` is set when the student
/// opens the prefilled WhatsApp deep link.
model CafeOrder {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  /// Human-friendly pickup reference, e.g. "KIZ-CAFE-0021".
  refCode        String    @unique @map("ref_code")
  /// Snapshot frozen at order time: [{ name, price, qty }].
  items          Json      @map("items")
  subtotal       Float
  /// Requested pickup time, free text ("12:45 PM" / "After class").
  pickupTime     String?   @map("pickup_time")
  note           String?
  whatsappSentAt DateTime? @map("whatsapp_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("cafe_orders")
}

/// Admin-editable welcome slides shown once on the mobile app's first launch.
/// `gradient` is a key from `packages/shared/src/onboarding-meta.ts`.
model OnboardingSlide {
  id              String    @id @default(uuid())
  title           String
  body            String?
  imageUrl        String?   @map("image_url")
  gradient        String    @default("teal")
  /// Overlay strength (0–100) of the gradient over the slide image.
  gradientOpacity Int       @default(60) @map("gradient_opacity")
  buttonLabel     String?   @map("button_label")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([sortOrder])
  @@map("onboarding_slides")
}

{
  "expo": {
    "name": "MyKIZ",
    "slug": "mykiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mykiz",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "my.kiz.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "MyKIZ uses the camera to scan the KIZ counter check-in QR code.",
        "NSPhotoLibraryUsageDescription": "MyKIZ needs photo access so you can set a profile picture and attach photos to reports.",
        "NSLocationWhenInUseUsageDescription": "MyKIZ uses your location for the AR Directory walking directions.",
        "NSMotionUsageDescription": "MyKIZ uses motion sensors to point the AR Directory compass at your destination."
      }
    },
    "android": {
      "package": "my.kiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#0891B2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0891B2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0891B2",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MyKIZ uses the camera to scan the KIZ counter check-in QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyKIZ needs photo access so you can set a profile picture and attach photos to reports.",
          "cameraPermission": "MyKIZ uses the camera to take photos for reports."
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
